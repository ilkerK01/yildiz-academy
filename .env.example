DATABASE_URL=sqlite:///./yildiz.db
COOKIE_SECURE=0
USER_SESSION_DAYS=30
ADMIN_SESSION_HOURS=8
SITE_URL=http://127.0.0.1:8000
# Yüklenen videolar ve Word görselleri (varsayılan: proje içinde medya/)
MEDIA_DIR=
VIDEO_MAX_MB=2048
# Profil fotoğrafları (varsayılan klasör: MEDIA_DIR/avatarlar)
AVATAR_DIR=
# Yüklenebilecek en büyük dosya (MB)
AVATAR_MAX_MB=5
# Saklanan kare görselin kenarı (piksel)
AVATAR_BOYUT=256
# Kabul edilen en küçük / en büyük kaynak görsel kenarı (piksel)
AVATAR_MIN_PX=64
AVATAR_MAX_PX=6000
# WebP kalitesi (1-100)
AVATAR_KALITE=85
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_SSL=1
SMTP_USER=resend
SMTP_PASS=
SMTP_FROM=Yildiz Academy <onboarding@resend.dev>
